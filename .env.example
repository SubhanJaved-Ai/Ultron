# ==============================================================================
# ULTRON — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` in the repository root and customize as needed:
#   cp .env.example .env
#
# NOTE: Do NOT commit your actual `.env` file containing real API keys or secrets.
# `.env` is ignored by Git by default.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & SECURITY
# ------------------------------------------------------------------------------
# API bearer key required for server access when bound publicly or in production.
# Generate a secure key with: jarvis auth generate-key
OPENJARVIS_API_KEY=your-secure-api-key-here

# Secret key used for signing authentication session tokens / JWTs
SECRET_KEY=change-me-to-a-random-32-character-secret

# Multi-user mode flag (true | false). Enables isolated user sessions and storage.
OPENJARVIS_MULTI_USER=false

# Allowed CORS origins for the FastAPI server (comma-separated list)
# Default allows local dev origins: http://localhost:5173,http://localhost:8000
OPENJARVIS_CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Port for the FastAPI backend server (default: 8000)
JARVIS_PORT=8000

# Host execution and storage directory override (default: ~/.openjarvis)
# OPENJARVIS_HOME=~/.openjarvis

# Sandboxed execution workspace root for autonomous tools
# OPENJARVIS_WORKSPACE=d:\Ultron\workspace

# ------------------------------------------------------------------------------
# 2. FRONTIER LLM PROVIDERS (Provide at least one preferred provider)
# ------------------------------------------------------------------------------
# Google Gemini API key (Primary default engine for Ultron Brain)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# GOOGLE_API_KEY=your-gemini-api-key-here

# OpenAI API key (for GPT-4o, o1, o3-mini models)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude API key (for Claude 3.5 Sonnet, Claude 3.7)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# OpenRouter Unified API key (access 200+ models via one gateway)
# OPENROUTER_API_KEY=your-openrouter-api-key-here

# Groq LPU API key (ultra-low latency inference for Llama 3 / Mixtral)
# GROQ_API_KEY=your-groq-api-key-here

# DeepSeek API key (DeepSeek-V3, DeepSeek-R1)
# DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Local Ollama endpoint (runs completely offline with zero paid API keys)
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. VOICE & AUDIO SYNTHESIS (Optional)
# ------------------------------------------------------------------------------
# ElevenLabs API key for ultra-realistic neural speech synthesis
# ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# Deepgram API key for real-time speech-to-text streaming
# DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Cartesia Sonic voice synthesis API key
# CARTESIA_API_KEY=your-cartesia-api-key-here

# ------------------------------------------------------------------------------
# 4. WEB SEARCH & RESEARCH TOOLS (Optional)
# ------------------------------------------------------------------------------
# Tavily API key for search and deep research agents
# TAVILY_API_KEY=your-tavily-api-key-here

# Serply Google search engine API key
# SERPLY_API_KEY=your-serply-api-key-here

# ------------------------------------------------------------------------------
# 5. FRONTEND & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Backend API base URL for the React / Vite frontend
VITE_API_URL=http://localhost:8000

# Optional API bearer token if required by the frontend client
# VITE_OPENJARVIS_API_KEY=your-client-api-key-here

# Optional Supabase integration for private vector memory sync
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 6. MODEL CONTEXT PROTOCOL (MCP) (Optional)
# ------------------------------------------------------------------------------
# Enable or disable MCP client tool provider integration (default: true)
# OPENJARVIS_MCP_ENABLED=true
# Optional config file path for pre-configured MCP servers (default: mcp.json)
# OPENJARVIS_MCP_CONFIG_PATH=mcp.json

